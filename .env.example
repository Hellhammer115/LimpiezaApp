# Copy to .env and fill in. NEVER commit .env.
# Only EXPO_PUBLIC_* values ship inside the app bundle — they are safe to
# expose BECAUSE every table is protected by Row Level Security.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key from Settings > API Keys ("Publishable and secret API keys"
# tab). Prefer it over the legacy anon JWT: legacy keys stop working at the end
# of 2026 and cannot be rotated without taking installed app versions down.
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key

# Optional: set to 1 to preview the UI with bundled sample data and no
# backend (auth/checkout inert). Never set in production builds.
# EXPO_PUBLIC_DEMO=1

# --- Edge Function secrets (set with `supabase secrets set`, NOT in .env) ---
# supabase secrets set MP_ACCESS_TOKEN=APP_USR-...   (Mercado Pago access token)
# supabase secrets set MP_WEBHOOK_SECRET=...         (Mercado Pago webhook signing secret)
# supabase secrets set RESEND_API_KEY=re_...          (Resend API key for quote emails; optional — emails are skipped without it)
# supabase secrets set QUOTES_FROM_EMAIL="LimpiezaApp <cotizaciones@tu-dominio.com>"
